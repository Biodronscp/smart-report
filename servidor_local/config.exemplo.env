# Configuração do servidor local. Copie este arquivo para "config.env" (na mesma pasta) e ajuste.
# O config.env NÃO vai para o GitHub (tem chaves). Linhas com # são comentários.

# Onde ficam os dados (JSON, laudos, anexos de teste, backups diários e logs). Fora do projeto e de pastas sincronizadas.
PASTA_DADOS=C:\SmartReportDados

# Porta do servidor (as pessoas acessam http://IP-DO-COMPUTADOR:5001)
PORT=5001

# TESTE: 1 = só leitura no Omie (bloqueia enviar OS, baixa de estoque, troca de etapa...). Para o uso real, apague esta linha.
OMIE_SOMENTE_LEITURA=1

# Chave do Gemini (botão "Laudo IA" e resumo do laudo). Opcional.
#GEMINI_API_KEY=

# Token do webhook do Omie (só se o Omie for avisar este servidor; precisa de endereço público). Opcional.
#OMIE_WEBHOOK_TOKEN=

# Espaço máximo (MB) para fotos/vídeos de teste anexados às OS.
MIDIA_MAX_TOTAL_MB=20000
